#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# The packaged desktop keeps NovaFlow state apart from DeepSeek Harness; the CLI must share it.
if [ -z "$DSH_HOME" ]; then
  DSH_HOME="$HOME/.novaflow"
  if [ ! -d "$DSH_HOME" ] && [ -d "$HOME/.hallucodex" ]; then DSH_HOME="$HOME/.hallucodex"; fi
fi
export DSH_HOME
ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/NovaFlow" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
